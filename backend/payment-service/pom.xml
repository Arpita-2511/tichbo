<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.eventtick</groupId>
    <artifactId>payment-service</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>payment-service</name>
    <description>
        Eventtick Payment Service — owns payment records for bookings (the
        `payments` table). Phase 15 Step 2. Does not own bookings,
        booking_seats, show_seats (booking-service), users (user-service),
        or catalog data.
    </description>

    <properties>
        <java.version>17</java.version>
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Needed for @Valid / @NotNull on request DTOs and the
             MethodArgumentNotValidException that produces. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Spring Security: this service independently validates the same
             JWTs user-service issues, so it can derive the caller's own
             identity (userId/role) server-side for payment ownership
             checks — the same defense-in-depth pattern user-service
             already uses for /api/users/me, not a new one. Unlike
             catalog-service/booking-service (which have no security
             dependency at all and fully trust the Gateway), this service
             needs to know *who* the caller is, not just *that* the Gateway
             already let the request through. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- JJWT: validates the JWTs user-service issues. Same choice
             user-service itself makes (self-issued/self-validated tokens,
             no external authorization server) — see JwtService there. -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Phase 16 Step 4: publishes PaymentSucceeded via this service's
             own transactional outbox — same dependency and reasoning as
             booking-service's own (see that module's pom.xml comment).
             Version comes from spring-boot-starter-parent's own dependency
             management, no explicit <version>. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <!-- Phase 14 Step 1 parity: health (liveness/readiness) and
             Prometheus metrics endpoints, service-local only — never
             routed through the Gateway. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Lets tests use MockMvc to drive Spring Security's filter chain
             end to end (e.g. asserting a missing/expired JWT is rejected) —
             same as user-service. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- A real, in-process Kafka broker for the outbox publisher's own
             tests (@EmbeddedKafka) — same "real infrastructure over a
             mock" choice booking-service's pom.xml already makes. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- In-memory DB for tests only, so `mvn test` doesn't require a
             live PostgreSQL connection. See src/test/resources/application.yml. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
